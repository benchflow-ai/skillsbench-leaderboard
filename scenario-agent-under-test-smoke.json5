{
  manifest_version: "0.4.0",
  experimental_features: ["docker"],

  config_schema: {
    type: "object",
    properties: {
      agent_under_test: {
        type: "object",
        properties: {
          harness: {
            type: "string",
            enum: ["openhands", "opencode", "claude-code", "codex", "gemini-cli", "terminus", "pi"],
            default: "openhands",
          },
          api_key: { type: "string", secret: true, default: "" },
          openai_api_key: { type: "string", secret: true, default: "" },
          anthropic_api_key: { type: "string", secret: true, default: "" },
          gemini_api_key: { type: "string", secret: true, default: "" },
          openrouter_api_key: { type: "string", secret: true, default: "" },
          qwen_api_key: { type: "string", secret: true, default: "" },
          deepseek_api_key: { type: "string", secret: true, default: "" },
          minimax_api_key: { type: "string", secret: true, default: "" },
          glm_api_key: { type: "string", secret: true, default: "" },
          kimi_api_key: { type: "string", secret: true, default: "" },
          xiaomi_api_key: { type: "string", secret: true, default: "" },
          doubao_api_key: { type: "string", secret: true, default: "" },
          hunyuan_api_key: { type: "string", secret: true, default: "" },
          provider: {
            type: "string",
            default: "",
            description: "Optional provider hint for selecting provider-specific API-key environment variables.",
          },
          base_url: {
            type: "string",
            default: "",
            description: "Optional OpenAI-compatible or provider-specific base URL.",
          },
          model: {
            type: "string",
            default: "gemini/gemini-3.5-flash",
          },
          timeout_sec: {
            type: "integer",
            default: 900,
          },
        },
        required: [],
        additionalProperties: false,
      },
    },
    required: ["agent_under_test"],
    additionalProperties: false,
  },

  components: {
    gateway: {
      manifest: "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      config: {
        assessment_config: {
          task_ids: ["dialogue-parser"],
          task_set: "agentbeats-real-model-smoke-v1",
          condition: "with_skills",
          allow_excluded_tasks: false,
          shard_index: 0,
          num_shards: 1,
        },
        participant_roles: { green: "skillsbench_green", purple1: "agent" },
      },
    },
    skillsbench_green: {
      manifest: "./green-agent.json5",
      config: {},
    },
    agent_under_test: {
      manifest: "./participant-agent-under-test.json5",
      config: {
        harness: "${config.agent_under_test.harness}",
        api_key: "${config.agent_under_test.api_key}",
        openai_api_key: "${config.agent_under_test.openai_api_key}",
        anthropic_api_key: "${config.agent_under_test.anthropic_api_key}",
        gemini_api_key: "${config.agent_under_test.gemini_api_key}",
        openrouter_api_key: "${config.agent_under_test.openrouter_api_key}",
        qwen_api_key: "${config.agent_under_test.qwen_api_key}",
        deepseek_api_key: "${config.agent_under_test.deepseek_api_key}",
        minimax_api_key: "${config.agent_under_test.minimax_api_key}",
        glm_api_key: "${config.agent_under_test.glm_api_key}",
        kimi_api_key: "${config.agent_under_test.kimi_api_key}",
        xiaomi_api_key: "${config.agent_under_test.xiaomi_api_key}",
        doubao_api_key: "${config.agent_under_test.doubao_api_key}",
        hunyuan_api_key: "${config.agent_under_test.hunyuan_api_key}",
        provider: "${config.agent_under_test.provider}",
        base_url: "${config.agent_under_test.base_url}",
        model: "${config.agent_under_test.model}",
        timeout_sec: "${config.agent_under_test.timeout_sec}",
      },
    },
  },

  bindings: [
    { to: "#gateway.green", from: "#skillsbench_green.a2a" },
    { to: "#gateway.purple1", from: "#agent_under_test.a2a" },
    { to: "#skillsbench_green.proxy", from: "#gateway.proxy", weak: true },
  ],

  exports: { results: "#gateway.results" },

  metadata: {
    agentbeats_ids: {
      skillsbench_green: "",
      agent: "",
      agent_under_test: "",
    },
    worker_mode: "embedded_green_worker",
    smoke_task: "dialogue-parser",
  },
}
