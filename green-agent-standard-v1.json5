{
  manifest_version: "0.4.0",
  experimental_features: ["docker"],

  config_schema: {
    type: "object",
    properties: {
      prebuilt_images: {
        type: "string",
        description: "JSON object mapping every standard-v1 task id to a digest-pinned prebuilt task environment image.",
      },
      openai_api_key: {
        type: "string",
        secret: true,
        description: "Optional OpenAI API key for task verifiers that declare OPENAI_API_KEY in task.toml.",
      },
    },
    required: ["prebuilt_images"],
    additionalProperties: false,
  },

  slots: {
    proxy: { kind: "a2a" },
    worker: { kind: "http", optional: true },
  },

  program: {
    image: "ghcr.io/benchflow-ai/skillsbench-agentbeats-worker@sha256:54d55c74c5411d18bedbd55376e59bda17e6205d927344bdb074c6f8c3683f05",
    entrypoint: "sh -lc 'uv run --no-sync python -m skillsbench_agentbeats.worker --host 127.0.0.1 --port 9010 --jobs-dir jobs/agentbeats-worker --environment docker & sleep 2; exec uv run --no-sync python -m skillsbench_agentbeats.server --host 0.0.0.0 --port 9009'",
    env: {
      SKILLSBENCH_AGENTBEATS_PROXY_URL: "${slots.proxy.url}",
      SKILLSBENCH_WORKER_URL: "http://127.0.0.1:9010",
      SKILLSBENCH_WORKER_TIMEOUT_SEC: "3600",
      SKILLSBENCH_WORKER_POLL_INTERVAL_SEC: "1.0",
      SKILLSBENCH_WORKER_REVISION: "e922c557e0535c1cc1995b69f4d2e29fdfed3c67",
      SKILLSBENCH_REVISION: "e922c557e0535c1cc1995b69f4d2e29fdfed3c67",
      BENCHFLOW_REVISION: "50df6238abf88dc43da7ae8eb4c895f0cc7d40ae",
      SKILLSBENCH_WORKER_IMAGE: "ghcr.io/benchflow-ai/skillsbench-agentbeats-worker@sha256:54d55c74c5411d18bedbd55376e59bda17e6205d927344bdb074c6f8c3683f05",
      SKILLSBENCH_WORKER_IMAGE_DIGEST: "sha256:54d55c74c5411d18bedbd55376e59bda17e6205d927344bdb074c6f8c3683f05",
      SKILLSBENCH_WORKER_PREBUILT_IMAGES: "${config.prebuilt_images}",
      OPENAI_API_KEY: {
        when: "config.openai_api_key",
        value: "${config.openai_api_key}",
      },
      SKILLSBENCH_WORKER_VERIFY_PREBUILT_IMAGES: "true",
      SKILLSBENCH_WORKER_REQUIRE_PREBUILT_IMAGES: "true",
      SKILLSBENCH_WORKER_MAX_TASK_CPUS: "4",
      SKILLSBENCH_WORKER_MAX_TASK_MEMORY_MB: "12000",
      SKILLSBENCH_PRIVATE_PROOF_DIR: "jobs/agentbeats-private-proof",
      SKILLSBENCH_PRIVATE_PROOF_URI_PREFIX: "local://agentbeats-private-proof",
      SKILLSBENCH_PRIVATE_PROOF_RETENTION: "github-actions-smoke-debug-only",
      SKILLSBENCH_REQUIRE_DURABLE_PRIVATE_PROOF: "false",
      BENCHFLOW_DOCKER_LOGS_HOST_MOUNTED: "false",
      BENCHFLOW_DOCKER_SAFE_CLEANUP: "true",
      DOCKER_BUILDKIT: "0",
      COMPOSE_DOCKER_CLI_BUILD: "0",
      SKILLSBENCH_WORKER_PARTICIPANT_PROXY_URL: "${slots.proxy.url}",
    },
    mounts: [
      { name: "docker_socket", path: "/var/run/docker.sock", from: "framework.docker" },
    ],
    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  exports: { a2a: "a2a" },

  metadata: {
    assessment_config: {
      tasks: "all",
      task_set: "standard-v1",
      condition: "with_skills",
      allow_excluded_tasks: false,
      shard_index: 0,
      num_shards: 20,
    },
    worker_mode: "embedded_green_worker",
    participant_roles: ["agent"],
  },
}
