{
  "manifest_version": "0.4.0",
  "experimental_features": [
    "docker"
  ],
  "config_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "task_ids": [
            "citation-check",
            "court-form-filling",
            "dialogue-parser",
            "offer-letter-generator",
            "powerlifting-coef-calc"
          ],
          "task_set": "deploy-smoke-v1",
          "condition": "with_skills",
          "allow_excluded_tasks": false,
          "shard_index": 0,
          "num_shards": 1
        },
        "participant_roles": {
          "green": "skillsbench_green",
          "purple1": "agent"
        }
      }
    },
    "skillsbench_green": {
      "manifest": "https://raw.githubusercontent.com/benchflow-ai/skillsbench-leaderboard/8e8e608fab452e6126432f1bfff51e8812ebff31/green-agent.json5",
      "config": {}
    },
    "placeholder_agent": {
      "manifest": "https://raw.githubusercontent.com/benchflow-ai/skillsbench-leaderboard/8e8e608fab452e6126432f1bfff51e8812ebff31/participant-placeholder.json5",
      "config": {}
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#skillsbench_green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#placeholder_agent.a2a"
    },
    {
      "to": "#skillsbench_green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "skillsbench_green": "",
      "agent": "",
      "placeholder_agent": ""
    },
    "worker_mode": "embedded_green_worker"
  }
}
