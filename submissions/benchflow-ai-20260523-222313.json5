        "hunyuan_api_key": "${config.agent_under_test.hunyuan_api_key}",
        "provider": "${config.agent_under_test.provider}",
        "base_url": "${config.agent_under_test.base_url}",
        "model": "${config.agent_under_test.model}",
        "timeout_sec": "${config.agent_under_test.timeout_sec}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#skillsbench_green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent_under_test.a2a"
    },
    {
      "to": "#skillsbench_green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "skillsbench_green": "",
      "agent": "",
      "agent_under_test": ""
    },
    "worker_mode": "embedded_green_worker",
    "task_set": "standard-v1",
    "prebuilt_task_env_required": true,
    "num_shards": 20
  }
}
